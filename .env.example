# Copy to .env and fill in real values: cp .env.example .env
# Every variable here is validated at runtime in src/lib/env.ts — update both together.

# PostgreSQL connection string.
# Local dev options (pick one):
#   1. Docker:            docker compose up -d   (matches the URL below)
#   2. Prisma dev server: npx prisma dev          (zero install, prints its own URL)
#   3. Hosted:            Neon / Prisma Postgres / Supabase connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/property_manager"

# Optional: separate shadow database for `prisma migrate dev`, required when
# the DB user cannot CREATE DATABASE (prisma dev server, most hosted Postgres).
SHADOW_DATABASE_URL=""

# Better Auth. Generate a secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=""
# Base URL the app is served from (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"

# Initial LANDLORD account, created by `npm run db:seed` (idempotent).
# Only read by the seed script — never by the running app. There is no
# public registration; this is how the first account comes to exist.
# Password: 12+ characters (matches minPasswordLength in src/server/auth.ts).
SEED_LANDLORD_EMAIL=""
SEED_LANDLORD_PASSWORD=""
SEED_LANDLORD_NAME=""

# Stripe (Phase 5, optional — online payments degrade off cleanly if unset).
# Secret API key (sk_test_… in dev). Enables Checkout.
STRIPE_SECRET_KEY=""
# Webhook signing secret (whsec_…). From `stripe listen` or the dashboard.
STRIPE_WEBHOOK_SECRET=""
