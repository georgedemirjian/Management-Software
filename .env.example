# Copy to .env and fill in real values: cp .env.example .env
# Every variable here is validated at runtime in src/lib/env.ts — update both together.

# PostgreSQL connection string.
# Local dev options (pick one):
#   1. Docker:            docker compose up -d   (matches the URL below)
#   2. Prisma dev server: npx prisma dev          (zero install, prints its own URL)
#   3. Hosted:            Neon / Prisma Postgres / Supabase connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/property_manager"

# Better Auth. Generate a secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=""
# Base URL the app is served from (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"
